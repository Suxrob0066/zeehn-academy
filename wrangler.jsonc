{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeehn-academy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "keep_vars": true,
  "vars": { "EXTRA_CHAT_IDS": "5379894446" }
}
